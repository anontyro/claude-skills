# Claude Code telemetry -> local OTLP collector.
#
#   source ./claude-otel.env && claude
#
# Or put the same keys in the "env" block of .claude/settings.json, which
# applies them to every session in the project without touching your shell.

# --- Required -------------------------------------------------------------
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- The three signals ----------------------------------------------------
# Metrics: numeric time series. Dashboards, budgets, alerts.
export OTEL_METRICS_EXPORTER=otlp
# Events: one structured log record per prompt, tool call, API request, error.
export OTEL_LOGS_EXPORTER=otlp
# Traces: per-turn span tree, with subagent spans nested under the parent's
# tool span. Beta, and needs the companion flag below.
export OTEL_TRACES_EXPORTER=otlp
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1

# --- Export intervals -----------------------------------------------------
# Defaults are 60s for metrics and 5s for logs. 10s metrics makes a workflow
# run legible while it's still going; raise it back once you're past setup.
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_LOGS_EXPORT_INTERVAL=5000

# Prometheus needs cumulative counters. Without this you get deltas and your
# rate() queries quietly return nothing useful.
export OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative

# --- Detail level ---------------------------------------------------------
# Adds MCP server/tool names to tool_result events and populates
# tool_parameters for MCP and Skill calls. Also what stops your own workflow
# names showing up as "custom" instead of their meta.name.
# Bash parameters (bash_command, full_command, description) ship by default.
export OTEL_LOG_TOOL_DETAILS=1

# Off by default and worth leaving off unless you're debugging a specific run:
# each of these indexes potentially sensitive content.
#   OTEL_LOG_USER_PROMPTS=1    # prompt text on user_prompt events
#   OTEL_LOG_TOOL_CONTENT=1    # what tool calls actually returned
#   OTEL_LOG_RAW_API_BODIES=1  # full request/response JSON (needs the BETA flag)

# --- Run labelling --------------------------------------------------------
# These become Prometheus labels (via resource_to_telemetry_conversion in the
# collector), so they're how you compare two versions of a workflow. Bump
# `variant` when you change a prompt, then diff the two label values.
export OTEL_RESOURCE_ATTRIBUTES="harness=local,variant=baseline"

# Sanity check without the stack running: swap the exporter to console and
# you'll see metrics printed straight to the terminal.
#   export OTEL_METRICS_EXPORTER=console
