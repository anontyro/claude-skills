{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/log-workflow-result.sh\"", "timeout": 20 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/log-workflow-result.sh\"", "timeout": 20 }
        ]
      }
    ]
  }
}
